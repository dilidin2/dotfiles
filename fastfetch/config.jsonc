{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Pink theme to match your sway/waybar accent (#e8a0bf = RGB 232,160,191)
  "display": {
    "color": {
      "keys": "38;2;85;131;78",
      "title": "38;2;85;131;78"
    }
  },

  "modules": [
    "title",
    "separator",

    // Just the distro name, no version/codename/arch
    { "type": "os", "format": "{name}" },

    "host",
    { "type": "kernel", "format": "Linux 6.12" },
    "uptime",
    "packages",

    // Shell name only, no version
    { "type": "shell", "format": "{pretty-name}" },

    // WM name only, no version/protocol - confirmed via `fastfetch -h wm-format`
    { "type": "wm", "format": "{process-name}" },

    "wmtheme",

    // Terminal name only, no version
    { "type": "terminal", "format": "{pretty-name}" },

    // CPU model only, no core count/freq
    { "type": "cpu", "format": "{name}" },

    // GPU model only, no [Discrete]/[Integrated] tag
    { "type": "gpu", "hideType": "integrated", "format": "{name}" },

    "memory",

    // Disk usage without the filesystem type - confirmed via `fastfetch -h disk-format`
    { "type": "disk", "format": "{size-used} / {size-total} ({size-percentage}%)" },

    "localip",
    "locale",
    "break",
    "colors"
  ]
}
