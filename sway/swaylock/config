# ═══════════════════════════════════════════════════════════
# Swaylock Configuration - Soft Lavender Theme
# Matches: SwayFX + Waybar + Wofi + Foot aesthetic
# ═══════════════════════════════════════════════════════════

# Background color (dark, matching system)
--color=122a1e

# Key ring color (soft lavender-pink, lighter)
--key-hl-color=477787

# Caps lock highlight color (soft accent)
--caps-lock-bs-hl-color=508777
--caps-lock-key-hl-color=508777

# Text color (white)
--text-color=c3c9c6

# Inner ring size
--ring-size=35

# Line width
--line-width=4

# Font
--font="JetBrains Mono NFR"

# Font size
--font-size=24

# Text position (centered vertically)
--text-ver-offset=-50

# Show input
--show-input

# Ignore password when screen is locked
--ignore-empty-password

# Daemonize
--daemonize

# Fade in/out effect
--fade-in=0.3

# Show remaining time until screen lock
# --remaining-time-only
